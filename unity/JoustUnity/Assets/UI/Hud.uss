/* Readability over a dark, high-contrast arena: heavy weight, wide tracking,
   and a shadow so the numbers survive being drawn over lava. */

.hud {
    flex-grow: 1;
    justify-content: space-between;
    padding: 18px 28px;
}

.hud-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-start;
}

.stat {
    flex-direction: column;
    align-items: flex-start;
    min-width: 120px;
}

.stat--center { align-items: center; }
.stat--right { align-items: flex-end; }

.stat-label {
    font-size: 13px;
    letter-spacing: 3px;
    color: rgba(228, 214, 200, 0.62);
    -unity-font-style: bold;
}

.stat-value {
    font-size: 34px;
    color: rgb(248, 238, 226);
    -unity-font-style: bold;
    text-shadow: 0 2px 5px rgba(0, 0, 0, 0.85);
}

.banner {
    font-size: 44px;
    color: rgb(255, 176, 92);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    text-shadow: 0 3px 10px rgba(0, 0, 0, 0.9);
    margin-bottom: 12%;
}
